rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isManager() {
      return isAdmin() || 
        (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
    }

    function isMechanic() {
      return isManager() || 
        (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mechanic');
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isValidNumber(value) {
      return value is number && value >= 0;
    }

    function isValidString(value) {
      return value is string && value.size() > 0;
    }

    // Garage System Collections
    match /garage/{document=**} {
      // Read access for authenticated users
      allow read: if signedIn();
      
      // Write access based on role
      allow write: if isMechanic();
      allow delete: if isManager();
    }

    // Suppliers collection
    match /garage/suppliers/{supplierId} {
      allow read: if signedIn();
      allow create: if isManager() && 
        isValidString(request.resource.data.name);
      allow update: if isManager();
      allow delete: if isManager();
    }

    // Purchases collection
    match /garage/purchases/{purchaseId} {
      allow read: if signedIn();
      allow create: if isMechanic() && 
        isValidString(request.resource.data.supplierId) &&
        isValidNumber(request.resource.data.amount);
      allow update: if isManager();
      allow delete: if isManager();
    }

    // Payments collection
    match /garage/payments/{paymentId} {
      allow read: if signedIn();
      allow create: if isMechanic() && 
        isValidString(request.resource.data.supplierId) &&
        isValidNumber(request.resource.data.amount);
      allow update: if isManager();
      allow delete: if isManager();
    }

    // Maintenance collections
    match /garage/maintenance/internal/{maintenanceId} {
      allow read: if signedIn();
      allow create: if isMechanic() && 
        isValidString(request.resource.data.jobId) &&
        isValidString(request.resource.data.technicianName) &&
        isValidNumber(request.resource.data.laborCost);
      allow update: if isMechanic();
      allow delete: if isManager();
    }

    match /garage/maintenance/external/{maintenanceId} {
      allow read: if signedIn();
      allow create: if isMechanic() && 
        isValidString(request.resource.data.jobId) &&
        isValidString(request.resource.data.vendorName) &&
        isValidNumber(request.resource.data.serviceCost);
      allow update: if isMechanic();
      allow delete: if isManager();
    }

    // Inventory collection with validation
    match /garage/inventory/{itemId} {
      allow read: if signedIn();
      allow create: if isManager() && 
        isValidString(request.resource.data.name) &&
        isValidNumber(request.resource.data.quantity);
      allow update: if isMechanic() && 
        // Only allow quantity updates for mechanics
        request.resource.data.keys().hasAll(['quantity', 'updatedAt']) &&
        isValidNumber(request.resource.data.quantity);
      allow delete: if isManager();
    }

    // Job parts collection
    match /garage/jobParts/{jobPartId} {
      allow read: if signedIn();
      allow create: if isMechanic() && 
        isValidString(request.resource.data.jobId) &&
        isValidString(request.resource.data.itemId) &&
        isValidNumber(request.resource.data.quantity);
      allow update: if isManager();
      allow delete: if isManager();
    }

    // Operation logs (read-only for most users)
    match /garage/operationLogs/{logId} {
      allow read: if isManager();
      allow create: if signedIn(); // Anyone can create logs
      allow update, delete: if false; // Logs are immutable
    }

    // Users collection (admin only)
    match /users/{userId} {
      allow read: if isOwner(userId) || isManager();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Master data collections
    match /master/{document=**} {
      allow read: if signedIn();
      allow create: if isManager();
      allow update: if isManager();
      allow delete: if isAdmin();
    }

    // Prevent mass operations
    match /{path=**}/batchWrite {
      allow read, write: if false;
    }

    // Rate limiting for critical operations
    match /garage/purchases/{purchaseId} {
      allow create: if isMechanic() && 
        isValidString(request.resource.data.supplierId) &&
        isValidNumber(request.resource.data.amount) &&
        request.time < timestamp.date(Date(2025, 1, 1)); // Temporary rate limit
    }

    // Data validation rules
    match /garage/inventory/{itemId} {
      allow create: if isManager() && 
        isValidString(request.resource.data.name) &&
        isValidNumber(request.resource.data.quantity) &&
        request.resource.data.quantity <= 10000; // Prevent unreasonable quantities
    }

    // Security rules for financial data
    match /garage/{collection}/{docId} {
      allow read: if signedIn();
      allow write: if isMechanic() && 
        // Prevent negative values
        (!request.resource.data.amount || request.resource.data.amount >= 0) &&
        (!request.resource.data.quantity || request.resource.data.quantity >= 0) &&
        (!request.resource.data.balance || request.resource.data.balance >= 0);
    }

    // Default deny for unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

// Realtime Database Rules (for compatibility)
{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    
    "garage": {
      ".read": "auth != null",
      ".write": "auth != null",
      
      "suppliers": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() in ['admin', 'manager']"
      },
      
      "maintenance": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() in ['admin', 'manager', 'mechanic']"
      },
      
      "inventory": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() in ['admin', 'manager', 'mechanic']",
        
        "$itemId": {
          ".validate": "newData.hasChildren(['name', 'quantity']) && newData.child('quantity').val() >= 0"
        }
      },
      
      "operationLogs": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() in ['admin', 'manager']",
        ".write": "auth != null",
        "$logId": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() in ['admin', 'manager']",
          ".write": "auth != null && !data.exists()" // Only allow creation
        }
      }
    },
    
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    
    "master": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() in ['admin', 'manager']"
    },
    
    "$other": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
