{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    
    "daily": {
      "$date": {
        ".read": "auth != null",
        ".write": "auth != null",
        "rows": {
          "$rowId": {
            ".read": "auth != null",
            ".write": "auth != null",
            "lock": {
              ".read": "auth != null",
              ".write": "auth != null"
            }
          }
        }
      }
    },
    
    "sharedLists": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$listId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$optionKey": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isString() && newData.val().length > 0"
        }
      }
    },
    
    "changeLog": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$logId": {
        ".validate": "newData.hasChildren(['action', 'user', 'createdAt'])"
      }
    }
  }
}
