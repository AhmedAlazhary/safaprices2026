rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isManager() {
      return isAdmin() || 
        (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'manager');
    }

    function isMechanic() {
      return isManager() || 
        (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mechanic');
    }

    function isDriver() {
      return isMechanic() || 
        (signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'driver');
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isValidTimestamp() {
      return request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidInventoryData() {
      return request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.availableQty is number
        && request.resource.data.availableQty >= 0
        && request.resource.data.purchasePrice is number
        && request.resource.data.purchasePrice >= 0
        && request.resource.data.reorderLevel is number
        && request.resource.data.reorderLevel >= 0;
    }

    function isValidOperationData() {
      return request.resource.data.type in ['issue', 'receive', 'return', 'transfer']
        && request.resource.data.itemId is string
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && request.resource.data.unitPrice is number
        && request.resource.data.unitPrice >= 0;
    }

    function canModifyInventory(itemId) {
      return isManager() || 
        (isMechanic() && 
         request.resource.data.purchasePrice == resource.data.purchasePrice &&
         request.resource.data.salePrice == resource.data.salePrice);
    }

    // Users collection - only admins can manage users
    match /users/{userId} {
      allow read: if isOwner(userId) || isManager();
      allow create: if isAdmin() && isValidTimestamp();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Vehicles collection
    match /vehicles/{vehicleId} {
      allow read: if isDriver();
      allow create: if isManager() && isValidTimestamp();
      allow update: if isManager();
      allow delete: if isAdmin();
    }

    // Staff collection
    match /staff/{staffId} {
      allow read: if isDriver();
      allow create: if isManager() && isValidTimestamp();
      allow update: if isManager();
      allow delete: if isAdmin();
    }

    // Inventory collection
    match /inventory/{itemId} {
      allow read: if isDriver();
      allow create: if isManager() && isValidInventoryData() && isValidTimestamp();
      allow update: if canModifyInventory(itemId);
      allow delete: if isAdmin();
      
      // Special rule for quantity updates by mechanics
      allow update: if isMechanic() && 
        request.resource.data.keys().hasAll(['availableQty', 'updatedAt', 'updatedBy']) &&
        request.resource.data.availableQty is number &&
        request.resource.data.availableQty >= 0;
    }

    // Operations collection
    match /operations/{operationId} {
      allow read: if isDriver();
      allow create: if isMechanic() && isValidOperationData() && isValidTimestamp();
      allow update: if isMechanic() && request.resource.data.status in ['pending', 'approved', 'completed', 'cancelled'];
      allow delete: if isAdmin();
    }

    // Maintenance Orders collection
    match /maintenance_orders/{orderId} {
      allow read: if isDriver();
      allow create: if isMechanic() && isValidTimestamp();
      allow update: if isMechanic() || resource.data.assignedMechanic == request.auth.uid;
      allow delete: if isManager();
    }

    // Audit Trail collection - read-only for most users
    match /audit_trail/{auditId} {
      allow read: if isManager();
      allow create: if isAdmin() && isValidTimestamp();
      allow update, delete: if false; // Audit trail should be immutable
    }

    // Notifications collection - user-specific
    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isManager() && isValidTimestamp();
      allow update: if isOwner(resource.data.userId) && 
        request.resource.data.keys().hasAll(['status', 'readAt']);
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Settings collection - admin only
    match /settings/{settingId} {
      allow read: if isManager();
      allow create: if isAdmin() && isValidTimestamp();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Documents collection (for Cloud Storage metadata)
    match /documents/{docId} {
      allow read: if isDriver();
      allow create: if isMechanic() && isValidTimestamp();
      allow update: if isOwner(resource.data.uploadedBy) || isManager();
      allow delete: if isOwner(resource.data.uploadedBy) || isAdmin();
    }

    // Security rules for batch operations
    match /{document=**} {
      allow read, write: if false;
    }

    // Index requirements
    match /vehicles/{vehicleId} {
      allow read: if isDriver();
      allow list: if isDriver();
    }

    match /inventory/{itemId} {
      allow read: if isDriver();
      allow list: if isDriver();
    }

    match /operations/{operationId} {
      allow read: if isDriver();
      allow list: if isDriver();
    }

    match /maintenance_orders/{orderId} {
      allow read: if isDriver();
      allow list: if isDriver();
    }

    // Prevent mass delete operations
    match /{path=**}/batchDelete {
      allow read, write: if false;
    }

    // Rate limiting for critical operations
    match /operations/{operationId} {
      allow create: if isMechanic() && 
        isValidOperationData() && 
        isValidTimestamp() &&
        request.time < timestamp.date(Date(2025, 1, 1)); // Temporary rate limit
    }

    // Data validation rules
    match /inventory/{itemId} {
      allow create: if isManager() && 
        isValidInventoryData() && 
        isValidTimestamp() &&
        request.resource.data.availableQty <= 10000; // Prevent unreasonable quantities
    }

    // Geographic restrictions (if applicable)
    match /{document=**} {
      allow read, write: if false; // Default deny
    }
  }
}

// Cloud Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    // Images folder
    match /images/{imageId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        request.resource.size < 5 * 1024 * 1024 && // 5MB limit
        request.resource.contentType.matches('image/.*');
    }

    // Documents folder
    match /documents/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        request.resource.size < 10 * 1024 * 1024 && // 10MB limit
        request.resource.contentType.matches('application/.*|image/.*');
    }

    // Profiles folder
    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        request.auth.uid == userId &&
        request.resource.size < 2 * 1024 * 1024 && // 2MB limit
        request.resource.contentType.matches('image/.*');
    }

    // Temporary uploads
    match /temp/{uploadId} {
      allow read, write: if request.auth != null && 
        request.resource.size < 20 * 1024 * 1024 && // 20MB limit
        request.time < timestamp.date(Date(2025, 1, 1)); // Auto-cleanup after time
    }
  }
}

// Realtime Database Rules (if needed)
{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'",
        ".write": "$uid === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    
    "settings": {
      ".read": "root.child('users').child(auth.uid).child('role').val() in ['admin', 'manager']",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    
    "logs": {
      ".read": "root.child('users').child(auth.uid).child('role').val() in ['admin', 'manager']",
      ".write": "root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    
    "$other": {
      ".read": "auth != null",
      ".write": "auth != null"
    }
  }
}
