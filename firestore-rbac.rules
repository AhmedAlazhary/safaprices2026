rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    function isManagerOrAbove() {
      return isAuthenticated() && 
             (request.auth.token.admin == true || request.auth.token.manager == true);
    }
    
    function isViewerOrAbove() {
      return isAuthenticated() && 
             (request.auth.token.admin == true || 
              request.auth.token.manager == true || 
              request.auth.token.viewer == true);
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isOriginalUser(userId) {
      return exists(/databases/$(database)/documents/user_roles/$(userId)) &&
             get(/databases/$(database)/documents/user_roles/$(userId)).data.isOriginalUser == true;
    }

    // SAFATRANS client-prices permission. This intentionally uses the same
    // four original administrator email identities recognized by the current
    // page guard, plus the explicit page-level `edit` grant in user_roles.
    // No custom claims are required for this module.
    function canManageClientPrices() {
      return isAuthenticated() && (
        request.auth.token.get('email', '') in [
          'ahmed@safatrans.com',
          'hesham@safatrans.com',
          'omar@safatrans.com',
          'sabry@safatrans.com'
        ] || (
          exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role == 'admin' ||
            get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.pages.client_prices == 'edit'
          )
        )
      );
    }

    function canViewClientPrices() {
      return canManageClientPrices() || (isAuthenticated() &&
        exists(/databases/$(database)/documents/user_roles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.get('pages', {}).get('client_prices', '') == 'view');
    }

    function hasValidCoordinates(data) {
      return (
        !data.keys().hasAny(['lat', 'lng']) &&
        !data.keys().hasAny(['coordinateSource'])
      ) || (
        data.keys().hasAll(['lat', 'lng', 'coordinateSource', 'coordinatesVerified']) &&
        data.lat is number && data.lat >= -90 && data.lat <= 90 &&
        data.lng is number && data.lng >= -180 && data.lng <= 180 &&
        data.coordinateSource is string && data.coordinateSource.size() > 0 &&
        data.coordinatesVerified == true
      );
    }

    function validClientPriceDraft(data, destinationId) {
      return data.keys().hasAll([
          'destinationId', 'name', 'light8t20ft', 'container40ft',
          'two20ft', 'currency', 'updatedAt', 'updatedBy'
        ]) &&
        data.keys().hasOnly([
          'destinationId', 'name', 'light8t20ft', 'container40ft',
          'two20ft', 'currency', 'lat', 'lng', 'coordinateSource', 'coordinatesVerified',
          'updatedAt', 'updatedBy'
        ]) &&
        data.destinationId == destinationId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.light8t20ft is number && data.light8t20ft > 0 &&
        data.container40ft is number && data.container40ft > 0 &&
        data.two20ft is number && data.two20ft > 0 &&
        data.currency == 'EGP' &&
        data.updatedAt == request.time &&
        data.updatedBy == request.auth.uid &&
        hasValidCoordinates(data);
    }

    function validPublicClientPrice(data, destinationId) {
      return data.keys().hasAll([
          'destinationId', 'name', 'light8t20ft', 'container40ft',
          'two20ft', 'currency', 'publishedAt', 'version'
        ]) &&
        data.keys().hasOnly([
          'destinationId', 'name', 'light8t20ft', 'container40ft',
          'two20ft', 'currency', 'publishedAt', 'version', 'lat', 'lng'
        ]) &&
        data.destinationId == destinationId &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.light8t20ft is number && data.light8t20ft > 0 &&
        data.container40ft is number && data.container40ft > 0 &&
        data.two20ft is number && data.two20ft > 0 &&
        data.currency == 'EGP' &&
        data.publishedAt == request.time &&
        data.version is int && data.version > 0 &&
        (
          !data.keys().hasAny(['lat', 'lng']) ||
          (
            data.keys().hasAll(['lat', 'lng']) &&
            data.lat is number && data.lat >= -90 && data.lat <= 90 &&
            data.lng is number && data.lng >= -180 && data.lng <= 180
          )
        );
    }

    function validClientPriceAudit(data) {
      return data.keys().hasAll(['action', 'createdAt', 'createdBy', 'createdByEmail']) &&
        data.keys().hasOnly([
          'action', 'createdAt', 'createdBy', 'createdByEmail', 'destinationId',
          'before', 'after', 'version', 'sourceFile', 'rowCount'
        ]) &&
        data.action in [
          'draft_saved', 'destination_added', 'destination_updated',
          'destination_deleted', 'import_applied', 'published', 'json_generated', 'restored'
        ] &&
        data.createdAt == request.time &&
        data.createdBy == request.auth.uid &&
        data.createdByEmail == request.auth.token.get('email', '');
    }

    // User roles collection - Admin only
    match /user_roles/{userId} {
      allow read: isAdmin() || isOwner(userId);
      allow write: isAdmin() && !isOriginalUser(userId);
      allow create: isAdmin();
      allow update: isAdmin() && !isOriginalUser(userId);
      allow delete: isAdmin() && !isOriginalUser(userId);
    }

    // Audit logs - Admin only for write, all authenticated for read
    match /audit_logs/{auditId} {
      allow read: isAdmin();
      allow write: isAdmin();
      allow create: isAdmin();
    }

    // Users collection - Admin only
    match /users/{userId} {
      allow read: isAdmin() || isOwner(userId);
      allow write: isAdmin();
      allow create: isAdmin();
      allow update: isAdmin();
      allow delete: isAdmin();
    }

    // Inventory collection
    match /inventory/{itemId} {
      allow read: isViewerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Operations collection
    match /operations/{operationId} {
      allow read: isViewerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Vehicles collection
    match /vehicles/{vehicleId} {
      allow read: isViewerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Staff collection
    match /staff/{staffId} {
      allow read: isViewerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Maintenance orders collection
    match /maintenance_orders/{orderId} {
      allow read: isViewerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Treasury collection
    match /treasury/{transactionId} {
      allow read: isManagerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Banks collection
    match /banks/{bankId} {
      allow read: isManagerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Invoices collection
    match /invoices/{invoiceId} {
      allow read: isManagerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Daily reports collection
    match /daily_reports/{reportId} {
      allow read: isViewerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Monthly reports collection
    match /monthly_reports/{reportId} {
      allow read: isViewerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: isOwner(resource.data.userId);
      allow write: isAdmin();
      allow create: isAdmin();
      allow update: isAdmin();
      allow delete: isAdmin();
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: isViewerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Settings collection - Admin only
    match /settings/{settingId} {
      allow read: isAdmin();
      allow write: isAdmin();
      allow create: isAdmin();
      allow update: isAdmin();
      allow delete: isAdmin();
    }

    // Backups collection - Admin only
    match /backups/{backupId} {
      allow read: isAdmin();
      allow write: isAdmin();
      allow create: isAdmin();
      allow update: isAdmin();
      allow delete: isAdmin();
    }

    // Shared lists collection
    match /shared_lists/{listId} {
      allow read: isViewerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Prices collection
    match /prices/{priceId} {
      allow read: isViewerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Warehouse collection
    match /warehouse/{itemId} {
      allow read: isViewerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Drivers collection
    match /drivers/{driverId} {
      allow read: isViewerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Upload files collection
    match /uploads/{fileId} {
      allow read: isViewerOrAbove();
      allow create: isManagerOrAbove();
      allow update: isManagerOrAbove();
      allow delete: isAdmin();
    }

    // Client prices: editor-only drafts, history, and immutable audit entries.
    match /clientPriceDrafts/{draftId} {
      allow read: canViewClientPrices();
      allow create, update: canManageClientPrices() &&
        request.resource.data.keys().hasOnly([
          'baseVersion', 'destinationCount', 'updatedAt', 'updatedBy', 'updatedByEmail', 'updatedByLabel'
        ]) &&
        request.resource.data.destinationCount is int &&
        request.resource.data.destinationCount >= 0 &&
        request.resource.data.destinationCount <= 150 &&
        request.resource.data.baseVersion is int &&
        request.resource.data.baseVersion >= 0 &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedByEmail == request.auth.token.get('email', '') &&
        request.resource.data.updatedByLabel is string &&
        request.resource.data.updatedByLabel.size() <= 160;
      allow delete: false;

      match /destinations/{destinationId} {
        allow read: canViewClientPrices();
        allow create, update: canManageClientPrices() &&
          validClientPriceDraft(request.resource.data, destinationId);
        allow delete: canManageClientPrices();
      }
    }

    match /clientPriceDraftRevisions/{revisionId} {
      allow read: canViewClientPrices();
      allow create: canManageClientPrices() &&
        request.resource.data.keys().hasOnly([
          'createdAt', 'createdBy', 'destinationCount', 'source', 'baseVersion', 'createdByEmail', 'createdByLabel'
        ]) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdByEmail == request.auth.token.get('email', '') &&
        request.resource.data.createdByLabel is string &&
        request.resource.data.createdByLabel.size() <= 160 &&
        request.resource.data.destinationCount is int &&
        request.resource.data.destinationCount >= 0 &&
        request.resource.data.destinationCount <= 150;
      allow update, delete: false;

      match /destinations/{destinationId} {
        allow read: canViewClientPrices();
        allow create: canManageClientPrices() &&
          validClientPriceDraft(request.resource.data, destinationId);
        allow update, delete: false;
      }
    }

    match /clientPriceVersionMeta/{versionId} {
      allow read: canViewClientPrices();
      allow create: canManageClientPrices() &&
        request.resource.data.keys().hasOnly([
          'version', 'createdAt', 'createdBy', 'destinationCount',
          'sourceDraftRevisionId', 'restoredFrom', 'createdByEmail', 'createdByLabel'
        ]) &&
        request.resource.data.version is int && request.resource.data.version > 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.createdByEmail == request.auth.token.get('email', '') &&
        request.resource.data.createdByLabel is string &&
        request.resource.data.createdByLabel.size() <= 160 &&
        request.resource.data.destinationCount is int &&
        request.resource.data.destinationCount > 0 &&
        request.resource.data.destinationCount <= 450;
      allow update, delete: false;
    }

    match /clientPriceVersions/{versionId}/destinations/{destinationId} {
      // All Firestore price history is private; customers read the static JSON file.
      allow get, list: canViewClientPrices();
      allow create: canManageClientPrices() &&
        validPublicClientPrice(request.resource.data, destinationId);
      allow update, delete: false;
    }

    match /clientPriceControl/{controlId} {
      allow get: canViewClientPrices() && controlId == 'current';
      allow list: false;
      allow create: controlId == 'current' && canManageClientPrices() &&
        request.resource.data.keys().hasOnly([
          'activeVersionId', 'version', 'currency', 'publishedAt'
        ]) &&
        request.resource.data.keys().hasAll(['activeVersionId', 'version', 'currency', 'publishedAt']) &&
        request.resource.data.activeVersionId is string && request.resource.data.activeVersionId.size() > 0 &&
        request.resource.data.version == 1 &&
        request.resource.data.currency == 'EGP' &&
        request.resource.data.publishedAt == request.time &&
        getAfter(/databases/$(database)/documents/clientPriceVersionMeta/$(request.resource.data.activeVersionId)).data.version == 1;
      allow update: controlId == 'current' && canManageClientPrices() &&
        request.resource.data.keys().hasOnly([
          'activeVersionId', 'version', 'currency', 'publishedAt'
        ]) &&
        request.resource.data.keys().hasAll(['activeVersionId', 'version', 'currency', 'publishedAt']) &&
        request.resource.data.activeVersionId is string && request.resource.data.activeVersionId.size() > 0 &&
        request.resource.data.version == resource.data.version + 1 &&
        request.resource.data.currency == 'EGP' &&
        request.resource.data.publishedAt == request.time &&
        getAfter(/databases/$(database)/documents/clientPriceVersionMeta/$(request.resource.data.activeVersionId)).data.version == request.resource.data.version;
      allow delete: false;
    }

    match /clientPriceAudit/{eventId} {
      allow read: canViewClientPrices();
      allow create: canManageClientPrices() && validClientPriceAudit(request.resource.data);
      allow update, delete: false;
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
